# ──────────────────────────────────────────────────────────────────────────────
# Vela — Women's Health Symptom Agent
# Copy this file to .env.local and fill in the values before running locally.
# Never commit .env.local to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── AI Provider ──────────────────────────────────────────────────────────────
# API key for tetrate.ai (Gemini 2.0 Flash Lite model router).
# Obtain yours at https://app.router.tetrate.ai
TETRATE_API_KEY=

# Base URL for the Tetrate model router API.
TETRATE_BASE_URL=

# Base URL for the DeepInfra OpenAI-compatible endpoint (used when AI_PROVIDER=deepinfra).
KIMI_BASE_URL=

# API key for DeepInfra (used when AI_PROVIDER=deepinfra). Obtain at https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

# AI provider to use. Options: "tetrate" | "deepinfra"
AI_PROVIDER=

# Model identifier passed to the chosen provider (e.g. gemini-2.0-flash-lite-001).
AI_MODEL_ID=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# API key for Resend — used to email the clinical PDF to the user.
# Obtain yours at https://resend.com/api-keys
RESEND_API_KEY=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Set to "true" to enforce per-IP request limits in production (50 req / 24 h).
# Set to "false" to bypass all rate limiting during local development/testing.
RATE_LIMIT_ENABLED=true
